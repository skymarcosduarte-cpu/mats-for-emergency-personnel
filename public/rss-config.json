  "palabras_clave_emergencias": {
    "desastres_naturales": {
      "sismos": ["sismo", "temblor", "terremoto", "réplica", "epicentro", "magnitud"],
      "meteorologicos": ["huracán", "ciclón", "tormenta tropical", "tornado", "granizada"],
      "hidrologicos": ["inundación", "desbordamiento", "deslizamiento", "alud", "avalancha"],
      "incendios": ["incendio forestal", "incendio", "conflagración", "quema"],
      "geologicos": ["erupción", "volcán", "actividad volcánica", "tsunami", "maremoto", "deslizamiento de tierra"]
    },
    "emergencias_humanas": {
      "violencia": ["atentado", "explosión", "bomba", "tiroteo", "balacera", "enfrentamiento"],
      "secuestros": ["secuestro", "desaparición", "levantón", "plagio"],
      "accidentes": ["accidente aéreo", "avión", "estrellamiento", "desplome", "choque masivo", "descarrilamiento"],
      "evacuaciones": ["evacuación", "desalojo", "éxodo", "desplazamiento forzado"]
    },
    "alertas_oficiales": {
      "emergencia": ["alerta", "emergencia nacional", "estado de emergencia", "desastre", "calamidad", "zona de desastre"],
      "proteccion_civil": ["protección civil", "alerta amarilla", "alerta naranja", "alerta roja"]
    },
    "salud_publica": {
      "enfermedades": ["brote", "epidemia", "pandemia", "contagio masivo"],
      "alertas": ["alerta sanitaria", "emergencia sanitaria", "cuarentena"]
    },
    "infraestructura_critica": {
      "servicios": ["apagón", "corte de luz masivo", "falla eléctrica", "sin agua"],
      "estructuras": ["colapso", "derrumbe", "hundimiento", "grieta"],
      "quimicos": ["fuga de gas", "derrame químico", "explosión química", "nube tóxica"]
    }
  },
  
  "sistema_scoring": {
    "descripcion": "Sistema de puntuación para determinar relevancia de noticias",
    "reglas": [
      {
        "condicion": "palabra_clave_en_titulo",
        "puntos": 10,
        "descripcion": "Palabra de emergencia encontrada en el título"
      },
      {
        "condicion": "palabra_clave_en_descripcion",
        "puntos": 5,
        "descripcion": "Palabra de emergencia encontrada en la descripción"
      },
      {
        "condicion": "palabra_alta_prioridad_titulo",
        "puntos": 15,
        "palabras": ["alerta", "emergencia", "evacuación", "muertos", "heridos", "desastre"],
        "descripcion": "Palabras críticas en el título"
      },
      {
        "condicion": "ubicacion_mexico",
        "puntos": 20,
        "ubicaciones": ["méxico", "cdmx", "ciudad de méxico", "guadalajara", "monterrey", "puebla", "tijuana"],
        "descripcion": "Evento ocurrido en México"
      },
      {
        "condicion": "ubicacion_latinoamerica",
        "puntos": 10,
        "ubicaciones": ["colombia", "argentina", "chile", "perú", "venezuela", "centroamérica"],
        "descripcion": "Evento ocurrido en Latinoamérica"
      },
      {
        "condicion": "multiples_fuentes",
        "puntos": 5,
        "por_fuente_adicional": true,
        "descripcion": "Bonus por cada fuente adicional que reporta el mismo evento"
      }
    ],
    "umbrales": {
      "critico": {
        "score_minimo": 50,
        "accion": "push_notification",
        "color": "rojo",
        "icono": "🔥"
      },
      "importante": {
        "score_minimo": 35,
        "accion": "badge_notification",
        "color": "naranja",
        "icono": "⚠️"
      },
      "relevante": {
        "score_minimo": 25,
        "accion": "mostrar_en_feed",
        "color": "azul",
        "icono": "📰"
      },
      "descartar": {
        "score_maximo": 24,
        "accion": "ignorar"
      }
    }
  },
  
  "configuracion_polling": {
    "intervalos_recomendados": {
      "alta_velocidad": {
        "minutos": 5,
        "fuentes": ["CNN Español", "AP", "Reuters"],
        "razon": "Breaking news, muy rápidos"
      },
      "velocidad_media": {
        "minutos": 10,
        "fuentes": ["Milenio", "El Universal", "BBC Mundo"],
        "razon": "Noticias nacionales importantes"
      },
      "velocidad_baja": {
        "minutos": 20,
        "fuentes": ["Proceso", "Animal Político", "NPR"],
        "razon": "Análisis y contexto"
      }
    },
    "optimizaciones": {
      "usar_conditional_requests": true,
      "headers_requeridos": ["If-Modified-Since", "ETag"],
      "cache_duracion_minutos": 5,
      "timeout_segundos": 30,
      "reintentos_en_error": 3,
      "backoff_exponencial": true
    },
    "rate_limiting": {
      "respetar_429": true,
      "respetar_retry_after_header": true,
      "backoff_minimo_segundos": 60,
      "backoff_maximo_segundos": 3600
    }
  },
  
  "limites_notificaciones": {
    "push_notifications": {
      "max_por_hora": 3,
      "max_por_dia": 15,
      "score_minimo": 50,
      "solo_eventos_criticos": true,
      "respetar_horario_descanso": {
        "activo": true,
        "hora_inicio": "23:00",
        "hora_fin": "07:00",
        "excepciones_score": 70
      }
    },
    "feed_noticias": {
      "max_noticias_mostradas": 30,
      "score_minimo": 25,
      "ordenar_por": "timestamp_desc"
    },
    "limpieza_automatica": {
      "eliminar_despues_horas": 48,
      "mantener_criticas_dias": 7,
      "mantener_con_multiples_fuentes_dias": 5,
      "archivar_en_lugar_de_eliminar": true
    }
  },
  
  "deduplicacion": {
    "algoritmo": "similitud_levenshtein",
    "umbral_similitud": 0.7,
    "ventana_temporal_horas": 2,
    "criterios": [
      "similitud_titulo > 70%",
      "diferencia_tiempo < 2 horas",
      "mismas_palabras_clave_criticas"
    ],
    "accion_al_detectar_duplicado": {
      "agregar_fuente": true,
      "actualizar_timestamp": true,
      "incrementar_score": 5,
      "mantener_titulo_mejor_redactado": true
    }
  },
  
  "geolocalizacion": {
    "activada": true,
    "priorizar_noticias_cercanas": true,
    "radio_relevancia_km": 500,
    "bonus_score_por_proximidad": {
      "0-50km": 30,
      "51-150km": 20,
      "151-300km": 10,
      "301-500km": 5
    },
    "fuentes_regionales": {
      "guadalajara": ["El Informador"],
      "cdmx": ["Reforma", "El Universal", "Milenio"],
      "monterrey": ["Agregar fuentes locales"]
    }
  },
  
  "preferencias_usuario": {
    "configurables": [
      {
        "opcion": "tipos_emergencias",
        "valores": ["sismos", "huracanes", "incendios", "violencia", "salud", "todas"],
        "default": "todas"
      },
      {
        "opcion": "region_interes",
        "valores": ["mexico", "latinoamerica", "norteamerica", "todas"],
        "default": "mexico"
      },
      {
        "opcion": "nivel_severidad",
        "valores": ["solo_critico", "importante_y_critico", "todas"],
        "default": "importante_y_critico"
      },
      {
        "opcion": "notificaciones_push",
        "valores": ["activadas", "solo_critico", "desactivadas"],
        "default": "solo_critico"
      },
      {
        "opcion": "horario_no_molestar",
        "valores": ["activado", "desactivado"],
        "default": "activado"
      },
      {
        "opcion": "radio_alertas_km",
        "valores": [50, 100, 200, 500, "sin_limite"],
        "default": 500
      }
    ]
  },
  
  "integracion_alertas_tecnicas": {
    "descripcion": "Correlacionar feeds RSS con alertas técnicas existentes",
    "flujo": [
      "1. Alerta técnica detecta evento (ej: USGS sismo 6.5)",
      "2. Sistema busca inmediatamente en feeds RSS noticias relacionadas",
      "3. Agrupa alerta técnica + noticias de medios",
      "4. Presenta contexto completo al usuario"
    ],
    "busqueda_palabras_relacionadas": {
      "sismo": ["sismo", "terremoto", "temblor", "réplica"],
      "huracan": ["huracán", "ciclón", "tormenta tropical"],
      "incendio": ["incendio", "conflagración", "quema"]
    },
    "ventana_busqueda_minutos": 30
  },
  
